# Public browser RPC only. Everything prefixed VITE_ is included in the client bundle.
VITE_BASE_RPC_URL=https://base-rpc.publicnode.com
# Optional: enables WalletConnect/mobile QR wallets. Injected browser wallets work without it.
VITE_WALLETCONNECT_PROJECT_ID=
# Optional: default landing & navigation shell variant (v1 | v3). Defaults to v1.
VITE_LANDING_VARIANT=v1
# Optional: show the bottom-left variant switcher pill in non-dev preview builds (always shown in dev).
VITE_ENABLE_VARIANT_SWITCHER=false
