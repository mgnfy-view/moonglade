# Base mainnet RPC for the local demo scripts. A private archive RPC may be faster.
BASE_RPC_URL=https://mainnet.base.org
# Public block selected by demo/run.sh and checked inside every demo.
DEMO_FORK_BLOCK=52000000
# Demo maker-selected pricing spread in basis points (0 disables; must be below 10000).
DEMO_TRADE_FEE_BPS=30

# Deployment uses existing contracts and an existing ungated Midnight market.
# Public addresses only; use Foundry CLI wallet options for signing.
DEPLOY_CHAIN_ID=8453
DEPLOYER_ADDRESS=
MAKER_ADDRESS=
MIDNIGHT_ADDRESS=0xAdedD8ab6dE832766Fedf0FaC4992E5C4D3EA18A
AQUA_ADDRESS=0x1111113CCf1426A8E30e2bfF5E005d929bF6a90a
WETH_ADDRESS=0x4200000000000000000000000000000000000006
MARKET_ID=

# Fill these from the confirmed DeployProtocol deployment before configuring the maker.
MOONGLADE_DESK_HOOK_ADDRESS=
PRICING_CURVE_ADDRESS=
# YieldSpace: WAD-scaled sensitivity/rate floor; spread in basis points, below 10000.
YIELDSPACE_SENSITIVITY=100000000000000000
RATE_FLOOR=5000000000000000
TRADE_FEE_BPS=30
# Optional raw bytes for a custom curve; overrides all three typed fields above.
# PRICING_CURVE_DATA=0x...

# Example maker limits for a USDC (6 decimals) / WETH (18 decimals) market.
# Debt is in Midnight units; fronting and burn limits are in native loan-token units.
MAX_DEBT=1000000000000
MAX_MINT_FRONT=1000000000000
MAX_BURN_COST=100000000
COLLATERAL_INDEX=0
TARGET_UTILIZATION=800000000000000000
MAX_COLLATERAL=1000000000000000000000
AUTO_BURN=true
# Aqua accounting budgets, in native loan-token and mgNOTE share units; not deposits.
VIRTUAL_LOAN_BALANCE=1000000000000
VIRTUAL_NOTE_BALANCE=2225540928492

# Optional native-unit allowance caps. Omitted values grant uint256.max.
# AQUA_LOAN_ALLOWANCE=1000000000000
# AQUA_NOTE_ALLOWANCE=1000000000000
# HOOK_LOAN_ALLOWANCE=1000000000000
# HOOK_NOTE_ALLOWANCE=1000000000000
# HOOK_COLLATERAL_ALLOWANCE=1000000000000000000000
